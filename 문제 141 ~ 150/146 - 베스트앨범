#include <string>
#include <vector>
#include <unordered_map>
#include <algorithm>

using namespace std;

bool cmpGenre(const pair<string, int>& a, const pair<string, int>& b) {
    return a.second > b.second;
}

bool cmpSong(const pair<int, int>& a, const pair<int, int>& b) {
    if (a.first == b.first) return a.second < b.second;
    return a.first > b.first;
}

vector<int> solution(vector<string> genres, vector<int> plays) {
    vector<int> answer;
    unordered_map<string, int> genreTotal;
    unordered_map<string, vector<pair<int, int>>> genreSongs;

    for (int i = 0; i < genres.size(); i++) {
        genreTotal[genres[i]] += plays[i];
        genreSongs[genres[i]].push_back({plays[i], i});
    }

    vector<pair<string, int>> sortedGenre(genreTotal.begin(), genreTotal.end());
    sort(sortedGenre.begin(), sortedGenre.end(), cmpGenre);

    for (auto& g : sortedGenre) {
        vector<pair<int, int>>& songs = genreSongs[g.first];
        sort(songs.begin(), songs.end(), cmpSong);

        for (int i = 0; i < songs.size() && i < 2; i++) {
            answer.push_back(songs[i].second);
        }
    }

    return answer;
}
