#include <string>
#include <vector>
#include <queue>
#include <algorithm>

using namespace std;

int solution(int n, vector<vector<int>> edge) {
    // 1. 인접 리스트 생성
    vector<vector<int>> graph(n + 1);
    for (int i = 0; i < edge.size(); i++) {
        graph[edge[i][0]].push_back(edge[i][1]);
        graph[edge[i][1]].push_back(edge[i][0]);
    }
    
    // 2. 거리 및 방문 체크 배열 (0번 인덱스 미사용)
    vector<int> dist(n + 1, 0);
    vector<bool> visited(n + 1, false);
    
    // 3. BFS 큐 선언 및 1번 노드 초기화
    queue<int> q;
    q.push(1);
    visited[1] = true;
    
    int max_dist = 0;
    
    while (!q.empty()) {
        int curr = q.front();
        q.pop();
        
        for (int i = 0; i < graph[curr].size(); i++) {
            int next = graph[curr][i];
            
            if (!visited[next]) {
                visited[next] = true;
                dist[next] = dist[curr] + 1;
                q.push(next);
                
                // 최대 거리 갱신
                if (dist[next] > max_dist) {
                    max_dist = dist[next];
                }
            }
        }
    }
    
    // 4. 최대 거리를 가진 노드 개수 카운트
    int answer = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == max_dist) {
            answer++;
        }
    }
    
    return answer;
}
