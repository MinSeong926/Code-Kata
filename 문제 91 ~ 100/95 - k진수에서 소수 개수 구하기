#include <string>
#include <vector>
#include <sstream>
#include <cmath>
#include <algorithm>

using namespace std;

// 10진수 숫자가 소수인지 판별하는 함수
bool isPrime(long long n) {
    if (n < 2) return false;
    for (long long i = 2; i * i <= n; i++) {
        if (n % i == 0) return false;
    }
    return true;
}

int solution(int n, int k) {
    int answer = 0;
    string converted = "";

    // k진수로 변환 (나머지를 이용해 뒤집힌 문자열 생성)
    while (n > 0) {
        converted += to_string(n % k);
        n /= k;
    }
    reverse(converted.begin(), converted.end());

    // '0'을 기준으로 문자열 분리
    stringstream ss(converted);
    string token;
    while (getline(ss, token, '0')) {
        if (token.empty()) continue; // 연속된 0으로 인해 빈 문자열이 된 경우 무시
        if (isPrime(stoll(token))) {
            answer++;
        }
    }

    return answer;
}
