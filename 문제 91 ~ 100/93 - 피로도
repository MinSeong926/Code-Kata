#include <string>
#include <vector>

using namespace std;

int answer = 0;
bool V[8] = {0};

void dfs(int C, int K, vector<vector<int>> &dungeons) {
    if (C > answer) answer = C;
    
    for (int i = 0; i < dungeons.size(); i++) {
        if (!V[i] && dungeons[i][0] <= K) {
            V[i] = true;
            dfs(C + 1, K - dungeons[i][1], dungeons);
            V[i] = false;
        }
    }
}

int solution(int k, vector<vector<int>> dungeons) {
    dfs(0, k, dungeons);
    
    return answer;
}
