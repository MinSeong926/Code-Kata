#include <string>
#include <vector>
#include <iostream>
#include <deque>
#include <algorithm>

using namespace std;

int bfs(int y_point, int x_point, vector<vector<string>> map, vector<vector<int>> &visited){
    deque<pair<int,int>> deq;
    int dy[4]={-1,0,1,0};
    int dx[4]={0,-1,0,1};
    int cnt=0;
    
    deq.push_back(make_pair(y_point,x_point));
    visited[y_point][x_point]=1;
    
    while(deq.empty()!=1){
        int y=deq.front().first;
        int x=deq.front().second;
        cnt+=stoi(map[y][x]);
        deq.pop_front();
        
        for(int i=0; i<4; i++){
            int ny=y+dy[i];
            int nx=x+dx[i];
            
            if(ny<0 || ny>=map.size() || nx<0 || nx>=map[0].size())
                continue;
            if(visited[ny][nx]==1 || map[ny][nx]=="X")
                continue;
            
            deq.push_back(make_pair(ny,nx));
            visited[ny][nx]=1;
        }
    }
    return cnt;
}

vector<int> solution(vector<string> maps) {
    vector<int> answer;
    vector<vector<string>> map(maps.size(), vector<string>(maps[0].size()));
    vector<vector<int>> visited(maps.size(), vector<int>(maps[0].size(),0));
    
    for(int y=0; y<maps.size(); y++)
        for(int x=0; x<maps[0].size(); x++)
            map[y][x]=maps[y][x];
    
    for(int y=0; y<map.size(); y++){
        for(int x=0; x<map[0].size(); x++){
            if(map[y][x]!="X" && visited[y][x]==0)
                answer.push_back(bfs(y,x,map,visited));
        }
    }
    
    sort(answer.begin(),answer.end());
    if(answer.size()<1)
        answer.push_back(-1);
    
    return answer;
}
