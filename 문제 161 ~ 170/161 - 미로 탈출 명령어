#include <string>
#include <vector>
#include <cmath>
#include <algorithm>

using namespace std;

// 이동 방향 우선순위: d, l, r, u
int dx[] = {1, 0, 0, -1};
int dy[] = {0, -1, 1, 0};
char dir[] = {'d', 'l', 'r', 'u'};

string solution(int n, int m, int x, int y, int r, int c, int k) {
    string answer = "";
    
    // 출발지와 도착지 간의 최단 거리
    int dist = abs(x - r) + abs(y - c);
    
    // 도달할 수 없는 조건 (거리 초과 또는 홀/짝 불일치)
    if (dist > k || (k - dist) % 2 != 0) return "impossible";
    
    // k번 동안 사전순으로 빠른 방향(d, l, r, u)을 탐색
    while (k > 0) {
        bool moved = false;
        for (int i = 0; i < 4; ++i) {
            int nx = x + dx[i];
            int ny = y + dy[i];
            
            // 미로 격자 범위를 벗어나는지 확인
            if (nx <= 0 || nx > n || ny <= 0 || ny > m) continue;
            
            // 이동 후 남은 거리와 남은 이동 횟수(k - 1) 비교
            int remain_dist = abs(nx - r) + abs(ny - c);
            if (remain_dist <= k - 1) {
                x = nx;
                y = ny;
                answer += dir[i];
                k--;
                moved = true;
                break;
            }
        }
        // 이동할 수 있는 경로가 없는 경우
        if (!moved) return "impossible";
    }
    
    return answer;
}
