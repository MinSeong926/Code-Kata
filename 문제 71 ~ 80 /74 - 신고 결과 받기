#include <string>
#include <vector>
#include <unordered_map>
#include <set>
#include <sstream>

using namespace std;

vector<int> solution(vector<string> id_list, vector<string> report, int k) {
    vector<int> answer(id_list.size(), 0);
    
    // 유저별 index 저장 맵 (결과 배열 순서 맞추기 위함)
    unordered_map<string, int> user_idx;
    for (int i = 0; i < id_list.size(); i++) {
        user_idx[id_list[i]] = i;
    }

    // [피신고자] : [신고한 사람들 set] (중복 신고 방지를 위해 set 사용)
    unordered_map<string, set<string>> reported_by;
    
    // 신고 내역 파싱 및 저장
    for (const string& r : report) {
        stringstream ss(r);
        string from, to;
        ss >> from >> to;
        reported_by[to].insert(from);
    }

    // k번 이상 신고당한 유저를 신고한 사람들에게 메일 발송 횟수 추가
    for (const auto& pair : reported_by) {
        const set<string>& reporters = pair.second;
        if (reporters.size() >= k) { // 정지 기준 충족
            for (const string& reporter : reporters) {
                answer[user_idx[reporter]]++;
            }
        }
    }

    return answer;
}
