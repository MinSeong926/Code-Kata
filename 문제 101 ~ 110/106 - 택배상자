#include <string>
#include <vector>
#include <stack>

using namespace std;

int solution(vector<int> order) {
    int answer = 0;
    stack<int> s;
    int belt = 1; // 컨테이너 벨트에서 나오는 상자 번호

    for (int i = 0; i < order.size(); i++) {
        int target = order[i];

        // 현재 벨트 상자가 찾는 상자보다 번호가 작으면, 찾는 번호가 나올 때까지 보조 벨트(스택)로 이동
        while (belt <= target) {
            s.push(belt);
            belt++;
        }

        // 보조 벨트의 맨 앞 상자가 찾는 상자인 경우 트럭에 적재
        if (!s.empty() && s.top() == target) {
            s.pop();
            answer++;
        } 
        // 그렇지 않다면 원하는 순서대로 상자를 실을 수 없으므로 종료
        else {
            break;
        }
    }

    return answer;
}
