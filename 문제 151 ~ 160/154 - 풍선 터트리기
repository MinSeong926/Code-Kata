#include <string>
#include <vector>
#include <algorithm>

using namespace std;

int solution(vector<int> a) {
    int n = a.size();
    if (n <= 2) return n; // 풍선이 2개 이하인 경우 전부 남길 수 있음

    vector<int> left_min(n);
    vector<int> right_min(n);

    // 왼쪽에서부터의 최소값
    int l_min = a[0];
    for (int i = 0; i < n; i++) {
        l_min = min(l_min, a[i]);
        left_min[i] = l_min;
    }

    // 오른쪽에서부터의 최소값
    int r_min = a[n - 1];
    for (int i = n - 1; i >= 0; i--) {
        r_min = min(r_min, a[i]);
        right_min[i] = r_min;
    }

    int answer = 0;
    // 양 끝은 무조건 살아남을 수 있음 (체크용)
    for (int i = 0; i < n; i++) {
        // 현재 풍선이 왼쪽 최소값보다 크고, 동시에 오른쪽 최소값보다도 크면 탈락
        if (a[i] > left_min[i] && a[i] > right_min[i]) {
            continue;
        }
        answer++;
    }

    return answer;
}
