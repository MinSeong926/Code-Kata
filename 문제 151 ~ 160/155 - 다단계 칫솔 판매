#include <string>
#include <vector>
#include <unordered_map>

using namespace std;

void distribute(string& name, int money, unordered_map<string, string>& parent, unordered_map<string, int>& total_money) {
    // 민호(center)에 도달하거나 더 이상 나눠줄 돈이 없으면 종료
    if (name == "-" || money == 0) {
        total_money[name] += money; // 민호 몫 또는 남은 금액 적립
        return;
    }
    
    int give_up = money / 10; // 10%
    int my_money = money - give_up; // 내가 가지는 90%
    
    total_money[name] += my_money;
    
    // 10% 금액이 1원 미만이면 위로 올려보내지 않음
    if (give_up > 0) {
        distribute(parent[name], give_up, parent, total_money);
    }
}

vector<int> solution(vector<string> enroll, vector<string> referral, vector<string> seller, vector<int> amount) {
    unordered_map<string, string> parent; // <자식, 부모>
    unordered_map<string, int> total_money; // <이름, 총 이익금>
    
    // 관계 연결
    for (int i = 0; i < enroll.size(); i++) {
        parent[enroll[i]] = referral[i];
    }
    
    // 판매 수익 분배
    for (int i = 0; i < seller.size(); i++) {
        distribute(seller[i], amount[i] * 100, parent, total_money);
    }
    
    // 결과 정돈
    vector<int> answer;
    for (int i = 0; i < enroll.size(); i++) {
        answer.push_back(total_money[enroll[i]]);
    }
    
    return answer;
}
