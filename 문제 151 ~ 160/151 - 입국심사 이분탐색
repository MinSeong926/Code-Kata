#include <string>
#include <vector>
#include <algorithm>
#include <iostream>

using namespace std;

long long solution(int n, vector<int> times) {
    long long answer = 0;
    
    // 이분탐색을 위한 정렬 및 범위 설정
    sort(times.begin(), times.end());
    
    long long left = 1;
    // 최댓값은 가장 오래 걸리는 심사위원 기준 전체 인원을 맡는 경우
    long long right = (long long)times.back() * n; 
    answer = right;
    
    while (left <= right) {
        long long mid = (left + right) / 2;
        long long sum = 0; // mid 시간 동안 심사할 수 있는 총 사람 수
        
        for (int i = 0; i < times.size(); i++) {
            sum += mid / times[i];
        }
        
        // 심사 가능 인원이 요구 인원(n)보다 많거나 같으면 -> 시간 줄이기 가능
        if (sum >= n) {
            answer = mid; // 최솟값 갱신
            right = mid - 1;
        } 
        // 심사 가능 인원이 부족하면 -> 시간 늘리기 필요
        else {
            left = mid + 1;
        }
    }
    
    return answer;
}
