#include <string>
#include <vector>
#include <algorithm>
#include <iostream>

using namespace std;

bool cmp(const vector<int>& a, const vector<int>& b) {
    if (a[0] == b[0]) return a[1] < b[1];
    return a[0] > b[0];
}

int solution(vector<vector<int>> scores) {
    int wanho_a = scores[0][0];
    int wanho_b = scores[0][1];
    int wanho_sum = wanho_a + wanho_b;
    
    sort(scores.begin(), scores.end(), cmp);
    
    int max_peer = 0;
    int answer = 1;
    
    for (auto& s : scores) {
        if (s[1] < max_peer) {
            if (s[0] == wanho_a && s[1] == wanho_b) return -1;
        } else {
            max_peer = max(max_peer, s[1]);
            if (s[0] + s[1] > wanho_sum) {
                answer++;
            }
        }
    }
    
    return answer;
}
